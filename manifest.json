{
  "name": "PhoneMirror",
  "version": "0.4.0",
  "author": "dcqwqc",
  "homepage": "https://github.com/dcqwqc/CaelestiaPlugin-PhoneMirror",
  "icon": "smartphone",
  "description": "Mirror Android over USB first, with secure Tailscale/Wireless Debugging fallback and a split click-through PIN guide control.",
  "entryPoints": [
    {
      "type": "custom",
      "source": "overlay/PinGuide.qml"
    },
    {
      "type": "quick-toggle",
      "source": "toggles/PhoneToggle.qml",
      "properties": {
        "name": "phone"
      }
    }
  ],
  "settings": "Settings.qml",
  "settingsUi": "SettingsUi.qml"
}

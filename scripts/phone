#!/usr/bin/env python3
"""Mirror an Android handset over USB or wireless ADB, as a configured device.

Which handset, what it is called and how hard it is pushed all live in
~/.config/caelestia/phone-mirror/device.conf rather than in this file. Nothing here names a
particular model.

    phone                mirror the configured handset (default)
    phone pair           pair a new handset over wireless debugging
    phone setup          write phone.conf from a handset that is connected now
    phone connect        reconnect the configured handset without launching scrcpy
    phone status         machine-readable state, for the shell's quick toggle
    phone input-key KEY  send one PIN digit/backspace to the connected handset
    phone fullscreen MODE toggle immersive mirror view (on/off/toggle/status)

Anything starting with '-' is passed straight through to scrcpy, which is what
phone-low and phone-off rely on.
"""
import json
import os
import re
import subprocess
import sys
import time

CONFIG_DIR = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "caelestia", "phone-mirror"
)
CONFIG_PATH = os.path.join(CONFIG_DIR, "device.conf")
STATE_DIR = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "caelestia")
STATE_PATH = os.path.join(STATE_DIR, "phone-mirror.json")
LEGACY_CONFIG_PATH = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "kagami", "phone.conf"
)

# One-time migration from the old monolithic Kagami location. Device identity is
# local state and never belongs in the cross-machine sync plugin.
if not os.path.exists(CONFIG_PATH) and os.path.isfile(LEGACY_CONFIG_PATH):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    try:
        import shutil
        shutil.copy2(LEGACY_CONFIG_PATH, CONFIG_PATH)
    except OSError:
        CONFIG_PATH = LEGACY_CONFIG_PATH

DEFAULTS = {
    "name": "Phone",
    # Substrings identifying the handset in `adb devices -l`. Empty means "the
    # only device connected", which is the right answer for a one-phone desk.
    "match": "",
    # An exact adb serial pins one handset when several are paired.
    "serial": "",
    # "tailscale" asks a helper on the phone for Android's current random
    # native Wireless Debugging TLS port over SSH, then connects ADB to that
    # port through the phone's Tailscale IP. "mdns" is LAN-only.
    "transport": "auto",
    "tailscale_ip": "",
    "ssh_host": "",
    "max_size": "1440",
    "video_bitrate": "16M",
    "max_fps": "120",
}


# The shell's plugin settings, if the PhoneMirror plugin is installed. Stream
# preferences live there so they can be changed from the Plugins page; the
# handset's identity stays in phone.conf, which is per-machine.
PLUGIN_ID = "dcqwqc/phonemirror"
PLUGIN_CONFIG = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
    "caelestia",
    "plugins.json",
)
# plugin setting -> phone.conf key, and how to render it
PLUGIN_SETTINGS = {
    "maxSize": ("max_size", str),
    "bitrateMbps": ("video_bitrate", lambda v: f"{v}M"),
    "maxFps": ("max_fps", str),
}


def apply_plugin_settings(config):
    """Let the Plugins page win over phone.conf for the stream knobs."""
    try:
        with open(PLUGIN_CONFIG) as handle:
            settings = json.load(handle).get("settings", {}).get(PLUGIN_ID, {})
    except (OSError, ValueError):
        return config, {}
    for key, (conf_key, render) in PLUGIN_SETTINGS.items():
        if key in settings:
            config[conf_key] = render(settings[key])
    return config, settings


def load_config():
    config = dict(DEFAULTS)
    try:
        with open(CONFIG_PATH) as handle:
            for line in handle:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, _, value = line.partition("=")
                key = key.strip()
                if key in config:
                    config[key] = value.strip()
    except OSError:
        return config, False
    return config, True


def notify(config, summary, body, urgency="normal"):
    level = "error" if urgency == "critical" else "info"
    icon = "phonelink_off" if urgency == "critical" else "smartphone"
    try:
        result = subprocess.run(
            [
                "qs", "-c", "caelestia", "ipc", "call", "toaster", level,
                summary, body, icon,
            ],
            check=False,
            timeout=3,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        if result.returncode == 0:
            return
    except (OSError, subprocess.SubprocessError):
        pass
    try:
        subprocess.run(
            ["notify-send", "-a", config["name"], "-u", urgency, summary, body],
            check=False,
            timeout=2,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except (OSError, subprocess.SubprocessError):
        pass


def run(cmd, timeout=None):
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return result.stdout.strip()
    except Exception:
        return ""


def load_state():
    try:
        with open(STATE_PATH) as handle:
            data = json.load(handle)
            return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def save_state(**changes):
    state = load_state()
    state.update(changes)
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        tmp = STATE_PATH + ".tmp"
        with open(tmp, "w") as handle:
            json.dump(state, handle, sort_keys=True)
            handle.write("\n")
        os.replace(tmp, STATE_PATH)
    except OSError:
        pass


def adb_connect(endpoint, timeout=5):
    out = run(["adb", "connect", endpoint], timeout=timeout)
    lower = out.lower()
    return ("connected to" in lower or "already connected to" in lower), out


def try_cached_tailscale(config):
    tailscale_ip = config.get("tailscale_ip", "").strip()
    port = load_state().get("adb_tls_port")
    if not tailscale_ip or not isinstance(port, int) or not 1 <= port <= 65535:
        return None
    endpoint = f"{tailscale_ip}:{port}"
    ok, _ = adb_connect(endpoint, timeout=3)
    return endpoint if ok else None


def cleanup_stale():
    for line in run(["adb", "devices"]).splitlines()[1:]:
        parts = line.split()
        if len(parts) >= 2 and parts[1] in ("offline", "unauthorized"):
            run(["adb", "disconnect", parts[0]], timeout=2)


def get_devices():
    devices = []
    for line in run(["adb", "devices", "-l"]).splitlines()[1:]:
        line = line.strip()
        if not line:
            continue
        parts = line.split()
        if len(parts) < 2:
            continue
        desc = " ".join(parts[2:])
        devices.append(
            {
                "serial": parts[0],
                "state": parts[1],
                "desc": desc,
                "emulator": parts[0].startswith("emulator-") or "sdk_gphone" in line,
                # `adb devices -l` includes usb:<bus-port> only for a local USB
                # transport. Network ADB serials are host:port endpoints.
                "usb": any(field.startswith("usb:") for field in parts[2:]),
            }
        )
    return devices


def matches(device, config):
    if config["serial"]:
        return device["serial"] == config["serial"]
    terms = config["match"].split()
    if not terms:
        return True
    haystack = f"{device['serial']} {device['desc']}".lower()
    return any(term.lower() in haystack for term in terms)


def select_target_device(devices, config):
    ready = [d for d in devices if d["state"] == "device"]
    # Prefer the configured handset, and within each pool always prefer a local
    # USB transport. This makes plugging the phone in deterministic even if an
    # old wireless ADB endpoint is still alive in the server.
    for pool in ([d for d in ready if matches(d, config)], ready):
        physical = [d for d in pool if not d["emulator"]]
        usb = [d for d in physical if d.get("usb")]
        if usb:
            return usb[0]
        if physical:
            return physical[0]
        if pool:
            return pool[0]
    return None


def select_target(devices, config):
    device = select_target_device(devices, config)
    return device["serial"] if device else None


def discover_tailscale_and_connect(config):
    """Connect through Tailscale, reusing the last working native ADB TLS port first."""
    tailscale_ip = config.get("tailscale_ip", "").strip()
    ssh_host = config.get("ssh_host", "").strip()
    if not tailscale_ip:
        return None

    cached = try_cached_tailscale(config)
    if cached:
        return cached
    if not ssh_host:
        return None

    out = run(
        [
            "ssh",
            "-o", "BatchMode=yes",
            "-o", "ConnectTimeout=4",
            ssh_host,
            'PATH="$HOME/bin:$PATH" adb-mdns-discover',
        ],
        timeout=8,
    )
    for line in out.splitlines():
        parts = line.split()
        if len(parts) < 3 or parts[0] != "connect":
            continue
        try:
            port = int(parts[2])
        except ValueError:
            continue
        if not 1 <= port <= 65535:
            continue
        endpoint = f"{tailscale_ip}:{port}"
        ok, _ = adb_connect(endpoint, timeout=5)
        if ok:
            save_state(adb_tls_port=port, adb_tls_endpoint=endpoint, adb_tls_seen=int(time.time()))
            return endpoint
    return None

def discover_and_connect(config=None):
    """Find handsets advertising wireless debugging over local-LAN mDNS."""
    try:
        proc = subprocess.Popen(
            ["avahi-browse", "-r", "-t", "-p", "_adb-tls-connect._tcp"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
        )
        out, _ = proc.communicate(timeout=3)
    except Exception:
        return
    for line in out.splitlines():
        if not line.startswith("="):
            continue
        parts = line.split(";")
        if len(parts) >= 9 and "." in parts[7]:
            endpoint = f"{parts[7]}:{parts[8]}"
            ok, _ = adb_connect(endpoint, timeout=3)
            if ok and config:
                try:
                    port = int(parts[8])
                except ValueError:
                    port = 0
                if 1 <= port <= 65535:
                    save_state(adb_tls_port=port, adb_lan_endpoint=endpoint, adb_tls_seen=int(time.time()))


def find_target(config, announce=True):
    run(["adb", "start-server"], timeout=5)
    cleanup_stale()
    target = select_target(get_devices(), config)
    if target:
        return target

    transport = config.get("transport", "auto").strip().lower() or "auto"
    if announce:
        label = "Tailscale" if transport == "tailscale" else "secure wireless ADB"
        notify(config, config["name"], f"USB not present; trying {label}...", "low")

    if transport in ("auto", "tailscale"):
        discover_tailscale_and_connect(config)
        for _ in range(4):
            time.sleep(0.35)
            target = select_target(get_devices(), config)
            if target:
                return target
        if transport == "tailscale":
            return None

    if transport in ("auto", "mdns"):
        discover_and_connect(config)
        for _ in range(4):
            time.sleep(0.5)
            target = select_target(get_devices(), config)
            if target:
                return target
    return None


def cmd_connect(config, configured):
    if not configured:
        print(f"No {CONFIG_PATH}. Run `phone pair` (or `phone setup`).", file=sys.stderr)
        return 2
    target = find_target(config)
    if not target:
        print(f"Could not connect {config['name']}.", file=sys.stderr)
        return 1
    print(target)
    return 0


def ssh_probe(config):
    ssh_host = config.get("ssh_host", "").strip()
    if not ssh_host:
        return False, "not configured"
    try:
        result = subprocess.run(
            ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=3", ssh_host, "true"],
            capture_output=True, text=True, timeout=5, check=False,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        return False, str(exc)
    return result.returncode == 0, (result.stderr or result.stdout).strip()


def cmd_doctor(config, configured):
    run(["adb", "start-server"], timeout=5)
    selected = select_target_device(get_devices(), config) if configured else None
    ssh_ok, ssh_detail = ssh_probe(config)
    state = load_state()
    tailscale_ip = config.get("tailscale_ip", "").strip()
    tail_ok = False
    tail_detail = "not configured"
    if tailscale_ip:
        try:
            result = subprocess.run(
                ["tailscale", "ping", "-c", "1", tailscale_ip],
                capture_output=True, text=True, timeout=5, check=False,
            )
            tail_ok = result.returncode == 0
            tail_detail = (result.stdout or result.stderr).strip()
        except (OSError, subprocess.SubprocessError) as exc:
            tail_detail = str(exc)

    print(f"configured:      {'yes' if configured else 'no'}")
    print(f"phone:           {config.get('name', 'Phone')}")
    print(f"transport:       {config.get('transport', 'auto')}")
    print(f"tailscale:       {'ok' if tail_ok else 'down'} ({tail_detail or tailscale_ip})")
    print(f"phone ssh:       {'ok' if ssh_ok else 'down'} ({ssh_detail or config.get('ssh_host', '')})")
    print(f"adb target:      {selected['serial'] if selected else 'none'}")
    print(f"cached adb port: {state.get('adb_tls_port', 'none')}")
    if not selected and tail_ok and not ssh_ok and not state.get("adb_tls_port"):
        print("diagnosis:       phone reachable, Termux SSH down, no cached ADB TLS port")
    elif not selected and tail_ok and not ssh_ok:
        print("diagnosis:       phone reachable, cached ADB port stale, Termux SSH down")
    elif selected:
        print("diagnosis:       ready")
    else:
        print("diagnosis:       no usable USB or wireless ADB path")
    return 0 if selected else 1


REMOTE_PERSIST_SCRIPT = """set -eu
BOOT_DIR="$HOME/.termux/boot"
BOOT_FILE="$BOOT_DIR/00-phone-mirror-ssh"
mkdir -p "$BOOT_DIR"
cat > "$BOOT_FILE" <<'EOF'
#!/data/data/com.termux/files/usr/bin/sh
export PATH="$PREFIX/bin:$HOME/bin:$PATH"
if command -v termux-wake-lock >/dev/null 2>&1; then
    termux-wake-lock >/dev/null 2>&1 || true
fi
if command -v sshd >/dev/null 2>&1; then
    pgrep -x sshd >/dev/null 2>&1 || sshd
fi
EOF
chmod 700 "$BOOT_FILE"
pgrep -x sshd >/dev/null 2>&1 || sshd
if pm list packages 2>/dev/null | grep -q '^package:com.termux.boot$'; then
    echo TERMUX_BOOT=installed
else
    echo TERMUX_BOOT=missing
fi
echo BOOT_FILE="$BOOT_FILE"
"""


def cmd_persist_ssh(config, configured):
    if not configured:
        return 2
    ssh_host = config.get("ssh_host", "").strip()
    if not ssh_host:
        print("No ssh_host configured.", file=sys.stderr)
        return 2
    try:
        result = subprocess.run(
            ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", ssh_host, "sh -s"],
            input=REMOTE_PERSIST_SCRIPT,
            capture_output=True,
            text=True,
            timeout=15,
            check=False,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        print(f"Could not reach phone SSH: {exc}", file=sys.stderr)
        return 1
    if result.returncode != 0:
        print((result.stderr or result.stdout).strip() or "Remote setup failed.", file=sys.stderr)
        return result.returncode or 1
    print(result.stdout.strip())
    if "TERMUX_BOOT=missing" in result.stdout:
        print("Termux:Boot is missing; install and open it once for reboot persistence.", file=sys.stderr)
        return 3
    print("Phone SSH boot persistence installed.")
    return 0


def cmd_status(config, configured):
    devices = get_devices()
    target_device = select_target_device(devices, config) if configured else None
    target = target_device["serial"] if target_device else None
    active_transport = ""
    if target_device:
        active_transport = "usb" if target_device.get("usb") else "wireless_adb"
    json.dump(
        {
            "configured": configured,
            "name": config["name"],
            "title": config["name"],
            "connected": bool(target),
            "serial": target or "",
            "transport": config.get("transport", "auto"),
            "active_transport": active_transport,
            "tailscale_ip": config.get("tailscale_ip", ""),
            "ssh_host": config.get("ssh_host", ""),
            "config": CONFIG_PATH,
        },
        sys.stdout,
    )
    sys.stdout.write("\n")
    return 0


def cmd_input_key(config, configured, key):
    """Send one explicit keypad key to the already-connected configured phone."""
    if not configured:
        return 2
    target = select_target(get_devices(), config)
    if not target:
        return 1

    key = key.strip().lower()
    keycodes = {str(n): f"KEYCODE_{n}" for n in range(10)}
    keycodes["backspace"] = "KEYCODE_DEL"
    code = keycodes.get(key)
    if not code:
        return 2

    result = subprocess.run(
        ["adb", "-s", target, "shell", "input", "keyevent", code],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=2,
        check=False,
    )
    return result.returncode



def _hypr_phone_client(config):
    try:
        result = subprocess.run(
            ["hyprctl", "clients", "-j"],
            capture_output=True,
            text=True,
            timeout=2,
            check=False,
        )
        clients = json.loads(result.stdout or "[]")
    except (OSError, subprocess.SubprocessError, ValueError):
        return None
    for client in clients:
        if client.get("title") == config["name"]:
            return client
    return None


def cmd_fullscreen(config, configured, mode):
    if not configured:
        return 2
    client = _hypr_phone_client(config)
    if not client:
        return 1

    current = int(client.get("fullscreen") or 0) > 1
    mode = (mode or "toggle").strip().lower()
    if mode == "status":
        print("on" if current else "off")
        return 0
    if mode == "toggle":
        desired = not current
    elif mode in ("on", "1", "true"):
        desired = True
    elif mode in ("off", "0", "false"):
        desired = False
    else:
        print("fullscreen mode must be on, off, toggle, or status", file=sys.stderr)
        return 2

    if desired == current:
        return 0

    address = str(client.get("address") or "").strip()
    if not address:
        return 1

    focused = subprocess.run(
        ["hyprctl", "dispatch", "focuswindow", f"address:{address}"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=2,
        check=False,
    )
    if focused.returncode != 0:
        return focused.returncode

    changed = subprocess.run(
        ["hyprctl", "dispatch", "fullscreen", "0"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=2,
        check=False,
    )
    return changed.returncode


def cmd_pair(config):
    """Android 11+ wireless debugging: a one-time pairing, then mDNS forever."""
    print(f"Pairing a handset with {os.uname().nodename}.\n")
    print("On the phone:")
    print("  Settings -> Developer options -> Wireless debugging -> ON")
    print("  tap 'Pair device with pairing code'\n")
    print("It shows an address like 192.168.1.23:37105 and a six-digit code.\n")
    try:
        endpoint = input("address (ip:port): ").strip()
        code = input("pairing code: ").strip()
    except (EOFError, KeyboardInterrupt):
        print("\nCancelled.")
        return 1
    if not re.fullmatch(r"[0-9.]+:\d+", endpoint) or not code.isdigit():
        print("\nThat does not look like an address and a code. Nothing done.")
        return 2

    run(["adb", "start-server"], timeout=5)
    result = subprocess.run(
        ["adb", "pair", endpoint, code], capture_output=True, text=True
    )
    print(result.stdout.strip() or result.stderr.strip())
    if result.returncode != 0:
        print("\nPairing failed. The code expires quickly -- try again.")
        return 1

    print("\nPaired. Looking for the handset over mDNS...")
    discover_and_connect(config)
    time.sleep(1)
    if select_target(get_devices(), {"serial": "", "match": ""}):
        print("Connected.\n")
        return cmd_setup(config)
    print("Paired, but it has not appeared yet. Leave wireless debugging on")
    print("and run 'phone setup' once it does.")
    return 0


def cmd_setup(config):
    """Write phone.conf from whatever is connected right now."""
    devices = [d for d in get_devices() if d["state"] == "device" and not d["emulator"]]
    if not devices:
        discover_and_connect(config)
        time.sleep(1)
        devices = [
            d for d in get_devices() if d["state"] == "device" and not d["emulator"]
        ]
    if not devices:
        print("No handset connected. Run 'phone pair' first.")
        return 1
    if len(devices) > 1:
        print("More than one handset is connected:")
        for index, device in enumerate(devices, 1):
            print(f"  {index}. {device['serial']}  {device['desc']}")
        try:
            choice = int(input("which one? ").strip())
            device = devices[choice - 1]
        except (ValueError, IndexError, EOFError, KeyboardInterrupt):
            print("Cancelled.")
            return 1
    else:
        device = devices[0]

    model = run(["adb", "-s", device["serial"], "shell", "getprop", "ro.product.model"])
    brand = run(["adb", "-s", device["serial"], "shell", "getprop", "ro.product.brand"])
    name = " ".join(part for part in (brand.title(), model) if part) or "Phone"

    # Match on the model reported in `adb devices -l`, which survives the
    # address changing, rather than on the current serial.
    model_tag = ""
    for field in device["desc"].split():
        if field.startswith("model:"):
            model_tag = field.split(":", 1)[1]
    terms = " ".join(dict.fromkeys(t for t in (model_tag, brand, model) if t))

    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(CONFIG_PATH, "w") as handle:
        handle.write(
            "# Written by `phone setup`. Hand-edit freely.\n"
            "#\n"
            "# name          window title, notification name, and what the\n"
            "#               shell's quick toggle matches its window on\n"
            "# match         substrings identifying the handset in\n"
            "#               `adb devices -l`; empty means the only one connected\n"
            "# serial        pin an exact adb serial when several are paired\n"
            f"name = {name}\n"
            f"match = {terms}\n"
            "serial =\n"
            f"transport = {config.get('transport', 'auto')}\n"
            f"tailscale_ip = {config.get('tailscale_ip', '')}\n"
            f"ssh_host = {config.get('ssh_host', '')}\n"
            f"max_size = {config['max_size']}\n"
            f"video_bitrate = {config['video_bitrate']}\n"
            f"max_fps = {config['max_fps']}\n"
        )
    print(f"\nWrote {CONFIG_PATH}:\n  name  = {name}\n  match = {terms}")
    print("\nThe quick toggle will pick it up on the shell's next start.")
    return 0


def cmd_mirror(config, configured, passthrough):
    config, settings = apply_plugin_settings(config)
    if not configured:
        notify(
            config,
            "No handset configured",
            f"Run `phone pair` in a terminal, or see {CONFIG_PATH}",
            "critical",
        )
        print(f"No {CONFIG_PATH}. Run `phone pair` (or `phone setup`).", file=sys.stderr)
        return 2

    target = find_target(config)
    if not target:
        message = (
            f"Could not find {config['name']}. "
            "Connect it over USB, or enable Wireless debugging while on Wi-Fi."
        )
        notify(config, f"{config['name']} - not found", message, "critical")
        print(f"\n[ERROR] {message}\n", file=sys.stderr)
        return 1

    cmd = [
        "scrcpy",
        f"--serial={target}",
        # The shell's quick toggle finds the running mirror by this title, and
        # the Hyprland float rule matches the scrcpy class beside it.
        f"--window-title={config['name']}",
        f"--max-size={config['max_size']}",
        f"--video-bit-rate={config['video_bitrate']}",
        f"--max-fps={config['max_fps']}",
    ]
    if settings.get("stayAwake", True):
        cmd.append("--stay-awake")
    if settings.get("screenOff", False):
        cmd.append("--turn-screen-off")
    cmd.extend(passthrough)
    os.execvp("scrcpy", cmd)


def main():
    config, configured = load_config()
    args = sys.argv[1:]
    # Bare words are subcommands; anything with a leading dash belongs to scrcpy.
    if args and not args[0].startswith("-"):
        command, rest = args[0], args[1:]
        if command == "status":
            return cmd_status(config, configured)
        if command == "connect":
            return cmd_connect(config, configured)
        if command == "doctor":
            return cmd_doctor(config, configured)
        if command == "persist-ssh":
            return cmd_persist_ssh(config, configured)
        if command == "input-key":
            return cmd_input_key(config, configured, rest[0] if rest else "")
        if command == "fullscreen":
            return cmd_fullscreen(config, configured, rest[0] if rest else "toggle")
        if command == "pair":
            return cmd_pair(config)
        if command == "setup":
            return cmd_setup(config)
        if command == "mirror":
            return cmd_mirror(config, configured, rest)
        print(__doc__, file=sys.stderr)
        return 2
    return cmd_mirror(config, configured, args)


if __name__ == "__main__":
    sys.exit(main() or 0)
